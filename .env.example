# Copia este archivo a .env y llena los valores EN TU COMPUTADORA O SERVIDOR. Nunca en el chat, nunca en git.
# ElevenLabs: llave restringida solo a Text to Speech. Voice ID y Model ID se copian de la web de ElevenLabs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Decisión: eleven_v4_turbo (~$0.04 por 1000 caracteres por API). eleven_v4 cuesta el doble ($0.08) con calidad igual dentro del margen de error.
ELEVENLABS_MODEL_ID=eleven_v4_turbo
# Panel DiniDine: llave de SOLO LECTURA (scope menu:read) y el host del admin de la marca.
DINIDINE_API_URL=
DINIDINE_API_KEY=

# --- Registro en la plataforma (publish.py sync) — cuenta Cloudinary ZAFNATECH (zafnatech@gmail.com), NUNCA la de contactdigidine ---
CLOUDINARY_CLOUD_NAME=
# Preset "unsigned" (solo video, carpeta zafnatech/): no hace falta ningún secreto de Cloudinary en este equipo.
CLOUDINARY_UPLOAD_PRESET=
# URL de la plataforma y token compartido con Vercel (CONTENT_INGEST_TOKEN). El token solo vive en .env y en Vercel.
CONTENT_INGEST_URL=https://TU-DOMINIO/api/content/ingest
CONTENT_INGEST_TOKEN=
